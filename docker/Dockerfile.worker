# Meter ingestion worker on Minimus. See ADR-0010.
#
#   docker build -f docker/Dockerfile.worker -t meter-worker .
#
# The dispatcher and the worker ship in one image so there is a single artefact
# to promote through environments.
#
# The role used to be selected with CMD ["sh", "-c", "python -m
# finops_ingest.${METER_ROLE}"]. That cannot work here: the runtime image has no
# shell, so nothing expands ${METER_ROLE}. The role is now a command argument,
# and the ECS task definition overrides `command` per service.
#
# CROSS PLATFORM BUILD. Read this before changing any FROM line.
#
# The target is linux/amd64. A build on an Apple Silicon machine produces a
# linux/arm64 image by default, and `docker push` does not convert it. The
# image lands in the registry as arm64, and the amd64 server fails at runtime
# with "exec format error", which reads like a broken binary rather than a
# wrong architecture.
#
# Two ARGs solve it, and both are needed for different reasons.
#
#   BUILDPLATFORM   the machine doing the building. The builder stage runs
#                   natively here, so compilation is fast rather than emulated.
#   TARGETPLATFORM  the machine that will run the image. The runtime stage is
#                   pinned to this.
#
# Build with buildx so the values are populated:
#   docker buildx build --platform linux/amd64 -f docker/Dockerfile.api -t meter-api .
#
# `make build` and `make buildx` already pass --platform. The pipeline passes
# --custom-platform to Kaniko for the same reason.
#

ARG PYTHON_VERSION=3.13
ARG TARGETPLATFORM
ARG BUILDPLATFORM

# reg.mini.dev/python:3.13-dev, pinned per ADR-0010. See docker/base-images.lock
FROM --platform=${BUILDPLATFORM} reg.mini.dev/python@sha256:4253ed59c60f7c926330ee548b5c014b5ad7551f60d5feaa10a4a98f6d951a15 AS builder

# The base image defaults to a non root user, and this stage has to write
# /opt/venv. Root here is safe and is not the posture ADR-0010 protects: the
# builder is discarded, nothing from it runs, and the runtime stage below keeps
# USER 65532:65532. Without this the build fails on `Permission denied:
# /opt/venv` and no image is produced at all. ISS-143.
USER root

ENV PIP_NO_CACHE_DIR=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1 \
    PYTHONDONTWRITEBYTECODE=1

WORKDIR /build

# Dependency layer first, so a source change does not reinstall the world.
# --no-compile keeps bytecode out of the image entirely rather than generating
# it and deleting it afterwards. Smaller image, one fewer layer. The cost is a
# slightly slower first import, which is irrelevant for a long running process.
COPY pyproject.toml ./
# pyproject declares six packages, and setuptools needs every one of them to
# exist before it can build metadata. Empty ones are enough for the dependency
# resolve below, and the real sources land in the COPY that follows. Without
# this the dependency layer fails on `package directory 'finops_core' does not
# exist`, which is why this stage never built. ISS-143.
RUN mkdir -p finops_core finops_providers finops_ingest finops_api finops_mcp finops_query \
 && touch finops_core/__init__.py finops_providers/__init__.py finops_ingest/__init__.py finops_api/__init__.py finops_mcp/__init__.py finops_query/__init__.py

RUN python -m venv /opt/venv \
 && /opt/venv/bin/pip install --upgrade pip setuptools wheel \
 && /opt/venv/bin/pip install --no-compile .

COPY finops_core/       ./finops_core/
COPY finops_providers/  ./finops_providers/
COPY finops_ingest/     ./finops_ingest/
COPY finops_api/        ./finops_api/
COPY finops_mcp/        ./finops_mcp/
COPY finops_query/      ./finops_query/
COPY alembic.ini       ./
COPY migrations/       ./migrations/

RUN /opt/venv/bin/pip install --no-compile --no-deps .

# reg.mini.dev/python:3.13, pinned per ADR-0010
FROM --platform=${TARGETPLATFORM} reg.mini.dev/python@sha256:06b604b79e52ed1e7c2bd73b007c6e4e2ceb5504030aa6c34b00aa9c7a92f41d

ARG TARGETPLATFORM

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PATH="/opt/venv/bin:$PATH"

WORKDIR /app

COPY --from=builder /opt/venv /opt/venv
COPY --from=builder /build/alembic.ini /app/alembic.ini
COPY --from=builder /build/migrations /app/migrations

USER 65532:65532

ARG GIT_SHA=unknown
LABEL org.opencontainers.image.title="meter-worker" \
      org.opencontainers.image.revision="${GIT_SHA}" \
      org.opencontainers.image.base.name="reg.mini.dev/python:${PYTHON_VERSION}" \
      io.meter.platform="${TARGETPLATFORM}" \
      io.meter.module="ingest"

# Override `command` in the ECS task definition to ["finops_ingest.dispatcher"].
ENTRYPOINT ["/opt/venv/bin/python", "-m"]
CMD ["finops_ingest.worker"]
