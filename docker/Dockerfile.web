# Meter frontend. Built to static assets, served by nginx behind the ALB.
#
#   docker build -f docker/Dockerfile.web -t meter-web .

FROM public.ecr.aws/docker/library/node:22-alpine AS builder

WORKDIR /build

COPY finops-web/package.json finops-web/package-lock.json ./
RUN npm ci

COPY finops-web/ ./
RUN npm run build

FROM public.ecr.aws/nginx/nginx:1.27-alpine AS runtime

COPY docker/nginx.conf /etc/nginx/conf.d/default.conf
COPY --from=builder /build/dist /usr/share/nginx/html

# nginx unprivileged: the upstream image already drops to uid 101 for workers,
# and the ALB terminates TLS, so this container listens on 8080 as non root.
RUN sed -i 's/listen       80;/listen       8080;/' /etc/nginx/conf.d/default.conf 2>/dev/null || true
USER nginx

EXPOSE 8080

HEALTHCHECK --interval=30s --timeout=3s --start-period=10s --retries=3 \
    CMD wget --quiet --tries=1 --spider http://127.0.0.1:8080/ || exit 1
