{
  "schemaVersion": 39,
  "editable": false,
  "refresh": "1m",
  "timezone": "utc",
  "templating": {
    "list": [
      {
        "name": "cloudwatch",
        "type": "datasource",
        "query": "cloudwatch",
        "current": {},
        "hide": 0
      },
      {
        "name": "region",
        "type": "constant",
        "query": "eu-west-1",
        "hide": 2
      },
      {
        "name": "load_balancer",
        "type": "constant",
        "query": "",
        "hide": 2
      },
      {
        "name": "work_queue",
        "type": "constant",
        "query": "",
        "hide": 2
      },
      {
        "name": "dlq",
        "type": "constant",
        "query": "",
        "hide": 2
      },
      {
        "name": "db_cluster",
        "type": "constant",
        "query": "",
        "hide": 2
      }
    ]
  },
  "timepicker": {
    "refresh_intervals": [
      "1m",
      "5m",
      "15m",
      "30m",
      "1h"
    ],
    "time_options": [
      "1h",
      "3h",
      "6h",
      "12h",
      "24h"
    ]
  },
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "uid": "meter-collection-health",
  "title": "Meter: collection health",
  "description": "Is every collector current, per collector. The internal twin of the user facing freshness screen, and the dashboard SLO 1 is read from. Scope level detail lives in sync_error rather than here, because a metric per account per region per collector is thousands of metrics and a bill this product would flag.",
  "tags": [
    "meter",
    "collection"
  ],
  "panels": [
    {
      "id": 1,
      "title": "Stalled scopes, by collector",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 0
      },
      "datasource": {
        "type": "cloudwatch",
        "uid": "${cloudwatch}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "namespace": "Meter",
          "metricName": "StalledScopes",
          "statistic": "Maximum",
          "period": "300",
          "region": "$region",
          "dimensions": {},
          "datasource": {
            "type": "cloudwatch",
            "uid": "${cloudwatch}"
          }
        }
      ]
    },
    {
      "id": 2,
      "title": "Stalled percent, against the five percent page threshold",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 0
      },
      "datasource": {
        "type": "cloudwatch",
        "uid": "${cloudwatch}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 5
              }
            ]
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "namespace": "Meter",
          "metricName": "StalledScopePercent",
          "statistic": "Maximum",
          "period": "300",
          "region": "$region",
          "dimensions": {},
          "datasource": {
            "type": "cloudwatch",
            "uid": "${cloudwatch}"
          }
        }
      ]
    },
    {
      "id": 3,
      "title": "Scopes under collection",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 8
      },
      "datasource": {
        "type": "cloudwatch",
        "uid": "${cloudwatch}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "namespace": "Meter",
          "metricName": "TotalScopes",
          "statistic": "Maximum",
          "period": "300",
          "region": "$region",
          "dimensions": {},
          "datasource": {
            "type": "cloudwatch",
            "uid": "${cloudwatch}"
          }
        }
      ]
    },
    {
      "id": 4,
      "title": "Runs, succeeded and partial against failed",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 8
      },
      "datasource": {
        "type": "cloudwatch",
        "uid": "${cloudwatch}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "namespace": "Meter",
          "metricName": "RunsTotal",
          "statistic": "Sum",
          "period": "3600",
          "region": "$region",
          "dimensions": {},
          "datasource": {
            "type": "cloudwatch",
            "uid": "${cloudwatch}"
          }
        },
        {
          "refId": "B",
          "namespace": "Meter",
          "metricName": "RunsFailed",
          "statistic": "Sum",
          "period": "3600",
          "region": "$region",
          "dimensions": {},
          "datasource": {
            "type": "cloudwatch",
            "uid": "${cloudwatch}"
          }
        }
      ]
    },
    {
      "id": 5,
      "title": "Age of the oldest retention job run",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 24,
        "x": 0,
        "y": 16
      },
      "datasource": {
        "type": "cloudwatch",
        "uid": "${cloudwatch}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "namespace": "Meter",
          "metricName": "RetentionJobAgeSeconds",
          "statistic": "Maximum",
          "period": "3600",
          "region": "$region",
          "dimensions": {},
          "datasource": {
            "type": "cloudwatch",
            "uid": "${cloudwatch}"
          }
        }
      ]
    }
  ]
}
