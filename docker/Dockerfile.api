# Meter API on Minimus. See ADR-0010.
#
#   docker build -f docker/Dockerfile.api -t meter-api .
#
# Two things about this file are not obvious and must not be tidied away.
#
# 1. The runtime stage has no shell and no package manager. Every CMD and
#    ENTRYPOINT is therefore in exec form. A CMD ["sh", "-c", ...] will not run,
#    it fails at container start with no useful message.
#
# 2. There is no HEALTHCHECK instruction. The runtime image has no curl and no
#    wget, and the ALB target group is what ECS actually gates a rollout on. A
#    Docker level health check here would be a second, weaker copy of a control
#    that already exists. Health checking lives in infra/terraform/hub/alb.tf.
#
# CROSS PLATFORM BUILD. Read this before changing any FROM line.
#
# The target is linux/amd64. A build on an Apple Silicon machine produces a
# linux/arm64 image by default, and `docker push` does not convert it. The
# image lands in the registry as arm64, and the amd64 server fails at runtime
# with "exec format error", which reads like a broken binary rather than a
# wrong architecture.
#
# Two ARGs solve it, and both are needed for different reasons.
#
#   BUILDPLATFORM   the machine doing the building. The builder stage runs
#                   natively here, so compilation is fast rather than emulated.
#   TARGETPLATFORM  the machine that will run the image. The runtime stage is
#                   pinned to this.
#
# Build with buildx so the values are populated:
#   docker buildx build --platform linux/amd64 -f docker/Dockerfile.api -t meter-api .
#
# `make build` and `make buildx` already pass --platform. The pipeline passes
# --custom-platform to Kaniko for the same reason.
#

ARG PYTHON_VERSION=3.13
ARG TARGETPLATFORM
ARG BUILDPLATFORM

# ---------- builder: has a shell, pip, and a compiler ----------
# reg.mini.dev/python:3.13-dev, pinned per ADR-0010. See docker/base-images.lock
FROM --platform=${BUILDPLATFORM} reg.mini.dev/python@sha256:4253ed59c60f7c926330ee548b5c014b5ad7551f60d5feaa10a4a98f6d951a15 AS builder

ENV PIP_NO_CACHE_DIR=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1 \
    PYTHONDONTWRITEBYTECODE=1

WORKDIR /build

# Dependency layer first, so a source change does not reinstall the world.
# --no-compile keeps bytecode out of the image entirely rather than generating
# it and deleting it afterwards. Smaller image, one fewer layer. The cost is a
# slightly slower first import, which is irrelevant for a long running process.
COPY pyproject.toml ./
RUN python -m venv /opt/venv \
 && /opt/venv/bin/pip install --upgrade pip setuptools wheel \
 && /opt/venv/bin/pip install --no-compile .

COPY finops_core/      ./finops_core/
COPY finops_providers/ ./finops_providers/
COPY finops_ingest/    ./finops_ingest/
COPY finops_api/       ./finops_api/
COPY finops_mcp/       ./finops_mcp/
COPY alembic.ini       ./
COPY migrations/       ./migrations/

RUN /opt/venv/bin/pip install --no-compile --no-deps .

# ---------- runtime: no shell, no package manager, near zero CVE ----------
# reg.mini.dev/python:3.13, pinned per ADR-0010
FROM --platform=${TARGETPLATFORM} reg.mini.dev/python@sha256:06b604b79e52ed1e7c2bd73b007c6e4e2ceb5504030aa6c34b00aa9c7a92f41d

ARG TARGETPLATFORM

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PATH="/opt/venv/bin:$PATH"

WORKDIR /app

COPY --from=builder /opt/venv /opt/venv
COPY --from=builder /build/alembic.ini /app/alembic.ini
COPY --from=builder /build/migrations /app/migrations

# Minimus runtime images already run as a non root user. Stated explicitly so a
# future edit does not quietly reintroduce root.
USER 65532:65532

# 8000 is the API, 8001 the MCP server when this image is run with that command.
EXPOSE 8000 8001

ARG GIT_SHA=unknown
LABEL org.opencontainers.image.title="meter-api" \
      org.opencontainers.image.revision="${GIT_SHA}" \
      org.opencontainers.image.base.name="reg.mini.dev/python:${PYTHON_VERSION}" \
      io.meter.platform="${TARGETPLATFORM}" \
      io.meter.module="api"

# The whole command is the CMD and there is no ENTRYPOINT, so a task definition
# selects which process runs by overriding it. That is how the MCP server ships
# as a second process in this image rather than as a fourth image, which would
# need its own build, scan, signature and repository. ADR-0009, A001-F08.
#
#   API  uvicorn finops_api.main:bootstrap  --factory --port 8000
#   MCP  uvicorn finops_mcp.server:bootstrap --factory --port 8001
#
# `--factory` because both targets are functions. They are functions so that
# importing either module for a test or a documentation gate does not open a
# database connection as a side effect. A test holds these two targets against
# the code, because a CMD naming a symbol that does not exist is a container
# that never starts and nothing else in the build would notice.
CMD ["/opt/venv/bin/uvicorn", "finops_api.main:bootstrap", "--factory", \
     "--host", "0.0.0.0", "--port", "8000", "--proxy-headers"]
