# Basic boiler Plate Doc | Grade A
# Why this file exists: Keeps build artefacts, virtualenvs and local state out of the repository.
# Grade A here: nothing in this file is specific to this project. Copy it unchanged.
# Grades: A copy into a new project as is, no edits. B copy it and swap the
# names, paths or patterns named above. C leave behind, it is this project's
# own content rather than scaffolding, and is not tagged.

# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# Node
node_modules/
dist/
build/
.vite/
*.tsbuildinfo

# Terraform
.terraform/
*.tfstate
*.tfstate.*
*.tfvars
!*.tfvars.example
.terraform.lock.hcl

# Secrets and local config
.env
.env.*
!.env.example
!.env.*.example
*.pem
*.key
local-auth.yaml
!local-auth.example.yaml

# Editors and OS
.DS_Store
.idea/
.vscode/
*.swp

# Scratch
scratch/
tmp/

# Claude Code local session state
.claude/state/

# The generated API reference. Published as a pipeline artifact rather than
# stored, because it is 4 MB of derived HTML that changes on every docstring.
docs/api/
