# Meter frontend on Minimus. See ADR-0010.
#
#   docker build -f docker/Dockerfile.web -t meter-web .
#
# No HEALTHCHECK, for the same reason as the API image: the runtime has no wget
# and no curl, and the ALB target group is the control that gates the rollout.
#
# CROSS PLATFORM BUILD. Read this before changing any FROM line.
#
# The target is linux/amd64. A build on an Apple Silicon machine produces a
# linux/arm64 image by default, and `docker push` does not convert it. The
# image lands in the registry as arm64, and the amd64 server fails at runtime
# with "exec format error", which reads like a broken binary rather than a
# wrong architecture.
#
# Two ARGs solve it, and both are needed for different reasons.
#
#   BUILDPLATFORM   the machine doing the building. The builder stage runs
#                   natively here, so compilation is fast rather than emulated.
#   TARGETPLATFORM  the machine that will run the image. The runtime stage is
#                   pinned to this.
#
# Build with buildx so the values are populated:
#   docker buildx build --platform linux/amd64 -f docker/Dockerfile.api -t meter-api .
#
# `make build` and `make buildx` already pass --platform. The pipeline passes
# --custom-platform to Kaniko for the same reason.
#

ARG NODE_VERSION=22
ARG TARGETPLATFORM
ARG BUILDPLATFORM
ARG NGINX_VERSION=1.30

# reg.mini.dev/node:22-dev, pinned per ADR-0010. See docker/base-images.lock
FROM --platform=${BUILDPLATFORM} reg.mini.dev/node@sha256:bec08ecc878a1735f8b0ac2e49ea31c4b8a5f1b1bca9fd226d17991d0626bc3e AS builder

# Same reason as the python images: the base image defaults to a non root user
# and this stage writes into /build. The builder is discarded and the runtime
# stage below keeps USER 65532:65532, so ADR-0010's posture is untouched.
USER root

WORKDIR /build

COPY finops-web/package.json finops-web/package-lock.json ./
RUN npm ci --no-audit --no-fund

COPY finops-web/ ./
RUN npm run build

# reg.mini.dev/nginx:1.30, pinned per ADR-0010
FROM --platform=${TARGETPLATFORM} reg.mini.dev/nginx@sha256:5ccdbdfe81fce440c26275b21448e70997c819633aefc04fe1fbf7516b81b81c

ARG TARGETPLATFORM

COPY docker/nginx.conf /etc/nginx/conf.d/default.conf
# Silences the base image's own server block, which would otherwise win
# every request whose Host is `localhost`. See the file for why.
COPY docker/nginx.disabled.conf /etc/nginx/conf.d/nginx.default.conf
COPY --from=builder /build/dist /usr/share/nginx/html

USER 65532:65532

EXPOSE 8080

ARG GIT_SHA=unknown
LABEL org.opencontainers.image.title="meter-web" \
      org.opencontainers.image.revision="${GIT_SHA}" \
      io.meter.platform="${TARGETPLATFORM}" \
      io.meter.module="web"
