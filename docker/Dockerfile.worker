# Meter ingestion worker. Same dependency set as the API, different entry point.
#
#   docker build -f docker/Dockerfile.worker -t meter-worker .

FROM public.ecr.aws/docker/library/python:3.12-slim AS builder

ENV PIP_NO_CACHE_DIR=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1 \
    PYTHONDONTWRITEBYTECODE=1

WORKDIR /build

RUN apt-get update \
 && apt-get install -y --no-install-recommends build-essential \
 && apt-get clean

COPY pyproject.toml ./
RUN python -m venv /opt/venv \
 && /opt/venv/bin/pip install --upgrade pip setuptools wheel \
 && /opt/venv/bin/pip install .

COPY finops_core/      ./finops_core/
COPY finops_providers/ ./finops_providers/
COPY finops_ingest/    ./finops_ingest/
COPY alembic.ini       ./
COPY migrations/       ./migrations/

RUN /opt/venv/bin/pip install --no-deps .

FROM public.ecr.aws/docker/library/python:3.12-slim AS runtime

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PATH="/opt/venv/bin:$PATH"

RUN groupadd --gid 10001 meter \
 && useradd --uid 10001 --gid meter --no-create-home --shell /usr/sbin/nologin meter

WORKDIR /app

COPY --from=builder /opt/venv /opt/venv
COPY --from=builder /build/alembic.ini /build/migrations ./

USER meter

# METER_ROLE selects the process. The dispatcher enumerates units of work and
# publishes them, the worker consumes them. Both ship in one image so there is
# a single artifact to promote through environments.
ENV METER_ROLE=worker

CMD ["sh", "-c", "python -m finops_ingest.${METER_ROLE}"]
