# Meter configuration.
#
# Copy to .env and edit. .env is gitignored, this file is not.
#
#   cp .env.example .env
#
# EVERY value the application reads comes from here, through one typed settings
# object. No os.environ elsewhere, and no literal region, account identifier,
# URL, timeout or threshold in application code. Enforced by
# scripts/ci/check_hardcoded.py, which fails the build. See ADR-0017.
#
# Columns in each block below:
#   WHAT      the value
#   WHY       what it does, and what changes if you change it
#   READ BY   the file that consumes it. This is the column that makes this
#             file useful a year from now
#
# Anything marked REQUIRED has no default. The process refuses to start without
# it, deliberately: a service that starts broken and fails on the first request
# has turned a deployment error into a production incident.


# ==========================================================================
# 1. ENVIRONMENT
# ==========================================================================

# WHAT     Which environment this process is running in.
# WHY      Gates behaviour that must never reach production. In particular the
#          local identity provider refuses to start when this is `prod`.
# READ BY  finops_core/config.py, finops_api/identity/local_config.py
# VALUES   local | dev | prod
# REQUIRED
METER_ENV=local

# WHAT     Log verbosity.
# WHY      DEBUG in local, INFO in deployed environments. DEBUG in production
#          is itself a CloudWatch cost problem, which this product would find.
# READ BY  finops_core/logging.py
METER_LOG_LEVEL=INFO


# ==========================================================================
# 2. DATABASE
# ==========================================================================

# WHAT     PostgreSQL connection string.
# WHY      Every fact Meter stores lives here. In deployed environments this is
#          injected from Secrets Manager by the ECS task role, never set here.
# READ BY  finops_api/db/session.py, alembic/env.py
# REQUIRED
METER_DATABASE_URL=postgresql+psycopg://meter:meter_local_only@postgres:5432/meter

# WHAT     Connection pool size per process.
# WHY      Too high and Aurora hits its connection limit with several workers
#          running. Too low and the workers queue on the pool instead of on AWS.
# READ BY  finops_api/db/session.py
METER_DB_POOL_SIZE=5
METER_DB_MAX_OVERFLOW=5


# ==========================================================================
# 3. AWS ACCESS
# ==========================================================================

# WHAT     Regions Meter collects from.
# WHY      The dispatcher fans out one unit of work per account per region per
#          collector, so this directly multiplies the work and the cost.
#          Currently Ireland and London only, confirmed 2026-08-23, OPEN-06.
# READ BY  finops_ingest/dispatcher.py
METER_REGIONS=eu-west-1,eu-west-2

# WHAT     The role Meter assumes in each member account.
# WHY      A name, not an ARN, because the account identifier varies per target
#          and the broker builds the ARN. Must match the StackSet in
#          infra/terraform/member.
# READ BY  finops_providers/aws/credentials.py
METER_COLLECTOR_ROLE_NAME=FinOpsCollectorRole

# WHAT     The role Meter assumes in the management account to read the
#          organization tree.
# WHY      Empty means the organization collector uses LocalStack instead of a
#          real management account, which is how development proceeds without
#          waiting for management account cooperation. See ISS-002.
# READ BY  finops_providers/aws/accounts.py
METER_ORG_READER_ROLE_ARN=

# WHAT     Secrets Manager name holding the cross account ExternalId.
# WHY      Never the value itself. The database stores a reference to this
#          name, not the secret. See docs/09-DATA-CLASSIFICATION.md.
# READ BY  finops_providers/aws/credentials.py
METER_EXTERNAL_ID_SECRET=meter/external-id

# WHAT     Override the AWS endpoint.
# WHY      Points every SDK call at LocalStack in local development. Empty in
#          every deployed environment. LocalStack does not enforce IAM, so a
#          permission boundary is never tested against it.
#          See docs/04-DEPLOYMENT.md.
# READ BY  finops_providers/aws/client.py
AWS_ENDPOINT_URL=http://localstack:4566

# WHAT     Placeholder credentials for LocalStack.
# WHY      LocalStack requires a value and ignores it. In deployed environments
#          credentials come from the ECS task role, and these are absent.
#          NEVER put a real key here.
# READ BY  boto3, via the environment
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
AWS_DEFAULT_REGION=eu-west-1

# WHAT     Network behaviour for cross account calls.
# WHY      A broken network path must fail fast rather than consume the whole
#          task timeout. At 300 accounts, default retry behaviour turns one
#          throttling event into a thundering herd.
# READ BY  finops_providers/aws/client.py
METER_AWS_CONNECT_TIMEOUT_SECONDS=10
METER_AWS_READ_TIMEOUT_SECONDS=30
METER_AWS_MAX_RETRIES=2

# WHAT     Where the billing export lands, and how Athena reads it.
# WHY      P1 reads cost from a Data Exports table rather than from Cost
#          Explorer, because Cost Explorer charges per request and cannot
#          return a resource identifier. The workgroup carries the result
#          location, which is why there is no setting for one here: enforcing
#          it on the workgroup is what stops a query writing results wherever
#          the caller fancied.
# READ BY  finops_providers/aws/cur.py
METER_CUR_EXPORT_BUCKET=meter-cost-exports-local
METER_CUR_EXPORT_PREFIX=exports/focus
METER_CUR_ATHENA_DATABASE=meter_cost
METER_CUR_ATHENA_TABLE=focus_daily
METER_CUR_ATHENA_WORKGROUP=meter

# WHAT     How far out a day must sit before the detector calls it an anomaly,
#          and the smallest dollar move worth a row at all.
# WHY      Three deviations is conventional and is a starting point, not a
#          finding: a real estate will move it. The floor outranks the ratio,
#          because a service costing two cents that triples is not news and
#          ADR-0016 says severity comes from the money.
# READ BY  finops_ingest/collectors/cost_anomaly.py
METER_ANOMALY_SENSITIVITY=3.0
METER_ANOMALY_FLOOR_USD=5.0

# WHAT     Metrics requested per GetMetricData call.
# WHY      500 is the API maximum. Lower it only to debug. GetMetricData is
#          billed per metric requested, so this is a cost lever as well as a
#          performance one.
# READ BY  finops_providers/aws/metrics.py
METER_GETMETRICDATA_BATCH_SIZE=500


# ==========================================================================
# 4. INGESTION
# ==========================================================================

# WHAT     SQS queue the dispatcher publishes to and workers consume from.
# WHY      One message per unit of work. Empty in a process that does not
#          ingest.
# READ BY  finops_ingest/dispatcher.py, finops_ingest/worker.py
METER_QUEUE_URL=http://localstack:4566/000000000000/meter-ingest

# WHAT     How long a claimed run may sit before another worker may reclaim it.
# WHY      A worker that dies mid run would otherwise block that scope forever.
#          Too low and two workers duplicate work, which is safe because of the
#          idempotency key, but wasteful.
# READ BY  finops_ingest/ledger.py
METER_RUN_CLAIM_TIMEOUT_MINUTES=30

# WHAT     Concurrent scope units per worker process.
# WHY      Raises throughput against performance budget 3 in P0 spec 11b, at
#          the cost of more concurrent AWS calls and more throttling risk.
# READ BY  finops_ingest/worker.py
METER_WORKER_CONCURRENCY=8

# NOTE     Collector cadence is NOT here. It lives in the collector_schedule
#          table with its reason and its estimated cost per run, so changing it
#          is a configuration change with a visible cost rather than a deploy.
#          See ADR-0012 and docs/06-DATA-FRESHNESS.md.


# ==========================================================================
# 5. IDENTITY AND SCOPE
# ==========================================================================

# WHAT     Which IdentityProvider implementation to use.
# WHY      `local_config` is development only and the application REFUSES TO
#          START when METER_ENV is prod and this is local_config. The SAML
#          adapter is deferred, see ADR-0008 and OPEN-01.
# READ BY  finops_api/identity/__init__.py
# VALUES   local_config | saml
METER_IDENTITY_PROVIDER=local_config

# WHAT     Which tenant the local provider issues principals for.
# WHY      That provider has no directory to read a tenant from. A real identity
#          provider carries it in the assertion, and starting in production with
#          the local provider is already refused, so this can never decide
#          anything there.
# READ BY  finops_api/main.py
# VALUE    The tenant `make seed` writes, because that is the only data a local
#          stack has. Point it elsewhere and every screen is empty.
METER_LOCAL_TENANT_ID=5eeded00-0000-4000-8000-000000000001

# WHAT     The YAML file the local provider reads.
# WHY      Created by `make up` from local-auth.example.yaml if absent.
# READ BY  finops_api/identity/local_config.py
METER_LOCAL_AUTH_FILE=/app/local-auth.yaml

# WHAT     How long a session lasts before re authentication.
# WHY      Bounds how long a revoked entitlement remains usable.
# READ BY  finops_api/identity/session.py
METER_SESSION_TTL_HOURS=8

# WHAT     How long a resolved entitlement is cached.
# WHY      The cache is never the source of truth. Longer means fewer identity
#          provider calls and slower propagation of a revocation.
# READ BY  finops_api/identity/__init__.py
METER_ENTITLEMENT_CACHE_TTL_MINUTES=15

# WHAT     Signing key for the session token.
# WHY      From Secrets Manager in deployed environments. A weak value here is
#          a total authentication bypass.
# READ BY  finops_api/identity/session.py
# REQUIRED
METER_SESSION_SIGNING_KEY=local-development-only-change-me


# ==========================================================================
# 6. THRESHOLDS AND TUNING
#
# These are read on every evaluation. They are NOT feature flags: a threshold
# is always applied, a flag creates a branch. Only branches accumulate test
# surface, which is why only flags carry an expiry. See ADR-0017.
# ==========================================================================

# WHAT     Monthly impact at which a cost finding takes each severity.
# WHY      Severity is derived from the money, never chosen, so the ranking
#          reflects impact rather than the author. 100 USD is material to one
#          organization and rounding error to another, hence configurable.
#          See ADR-0016.
# READ BY  finops_core/domain/recommendation.py
METER_SEVERITY_CRITICAL_USD=1000
METER_SEVERITY_HIGH_USD=100
METER_SEVERITY_MEDIUM_USD=20

# WHAT     Anomaly detection thresholds. ALL THREE must hold at once.
# WHY      Any one alone produces an alert stream that gets muted within a
#          month, and a muted detector is worse than none because everyone
#          believes it is watching. See FEAT-023.
# READ BY  finops_ingest/collectors/anomaly.py
METER_ANOMALY_Z_SCORE=3.0
METER_ANOMALY_ABSOLUTE_USD=50
METER_ANOMALY_RELATIVE_PERCENT=20
METER_ANOMALY_BASELINE_DAYS=30
METER_ANOMALY_AUTORESOLVE_DAYS=2

# WHAT     Rightsizing evidence rules.
# WHY      Never recommend on fewer than 14 days. Use p95 or p99, never max.
#          Lowering the minimum produces recommendations nobody will accept,
#          and rightly so. See ADR-0006.
# READ BY  finops_ingest/collectors/rightsizing.py
METER_RIGHTSIZING_MIN_DAYS=14
METER_RIGHTSIZING_PERCENTILE=95
METER_RIGHTSIZING_MEMORY_HEADROOM_PERCENT=15
METER_RIGHTSIZING_MEMORY_HEADROOM_OOMKILLED_PERCENT=25

# Workload parking, FEAT-054. A window is only reported when every observed week was
# quiet in it, so the idle percent is a ceiling on the busiest reading rather than an
# average. Five is deliberately low: a host with a monitoring agent on it idles at two
# to three percent, and a threshold above that would call a working resource quiet.
METER_PARKING_OBSERVATION_DAYS=14
METER_PARKING_IDLE_PERCENT=5
METER_PARKING_MINIMUM_WEEKS=2
METER_PARKING_MINIMUM_WINDOW_HOURS=3

# Commitment coverage as ranked actions, FEAT-055. The discount is modelled, not quoted:
# thirty percent is roughly a one year no upfront Compute Savings Plan on current public
# rates, and the finding says in words that the number came from configuration rather than
# from a quote. The term is what decides how long a wrong decision lasts.
METER_COMMITMENT_DISCOUNT_PERCENT=30
METER_COMMITMENT_TERM_MONTHS=12
METER_COMMITMENT_MINIMUM_MONTHLY_SAVING_USD=25

# Infrastructure as code state, FEAT-057. Locations are named rather than searched for:
# listing an account's buckets to see which hold state is reconnaissance whatever the
# intent. Comma separated s3 URLs, empty by default, so a deployment that has configured
# none reads nothing and every resource reads as not determined, which is true.
#
# METER_IAC_EXHAUSTIVE_ACCOUNTS is the only thing that lets Meter say a resource is
# unmanaged, and it is a claim about this configuration rather than about the cloud. Name
# an account here only when the backends above are the whole of its infrastructure as
# code. Get it wrong and Meter will tell somebody to import a resource that is already in
# a module, which produces a duplicate or a state conflict.
#
# No credential belongs in either. The backends are read with the same assumed role
# everything else uses.
METER_IAC_STATE_LOCATIONS=
METER_IAC_EXHAUSTIVE_ACCOUNTS=

# Blast radius, FEAT-044. Ten reachable resources is wide on the reasoning that a change
# touching ten things is one somebody reviews rather than applies, and the parts are
# published beside the band so a reader who disagrees can point at the count. Four hops
# matches the traversal default: beyond that an infrastructure graph tends to reach the
# whole VPC through a shared security group, which is true and not useful.
METER_BLAST_RADIUS_WIDE_AT=10
METER_BLAST_RADIUS_DEPTH=4

# Budgets, FEAT-060. Ten percent ahead of pace is at risk. Spending is lumpy, and a budget
# that flips to amber on a Tuesday because an annual invoice landed is a budget nobody
# trusts by Friday: this margin is what absorbs that. Lower it and the light is noisier,
# raise it and it warns too late to act.
METER_BUDGET_AT_RISK_MARGIN=0.1

# The assistant, P7 and ADR-0028. The model runs on Bedrock in the hub account, and which
# one is this setting alone. Empty means none has been chosen, which is OPEN-10, and the
# assistant then says it is not enabled. A model named here must also be named in the hub
# Terraform's assistant_model_ids, or the task role may not invoke it and every question
# fails as access denied.
#
# The prices are list prices in dollars per million tokens and they are modelled, not
# measured: the bill is the measurement, and the platform cost screen reads it by tag. The
# figures below are placeholders until OPEN-10 names a model, chosen to be in the range a
# mid sized model is listed at so that an estimate is plausible rather than zero.
METER_ASSISTANT_MODEL_ID=
METER_ASSISTANT_INPUT_USD_PER_MILLION_TOKENS=3.00
METER_ASSISTANT_OUTPUT_USD_PER_MILLION_TOKENS=15.00

# WHAT     Maximum nodes returned to the topology graph renderer.
# WHY      A browser will not survive more. Filtering happens server side.
# READ BY  finops_api/routes/topology.py
METER_MAX_GRAPH_NODES=2000

# WHAT     Data retention, in days. Enforced by scheduled jobs.
# WHY      See docs/09-DATA-CLASSIFICATION.md. A regulatory floor may exceed
#          the cost figure, which is ISS-078 and unanswered.
# READ BY  finops_ingest/collectors/retention.py
METER_RETENTION_PRINCIPAL_DAYS=90
METER_RETENTION_OPERATIONAL_DAYS=90
METER_RETENTION_AUDIT_DAYS=395
METER_RETENTION_COST_DAYS=1126


# ==========================================================================
# 7. FEATURE FLAGS
#
# Environment flags are the deploy time default. The per tenant runtime value
# lives in the feature_flag table and overrides this, so a feature can be
# switched off without a deploy.
#
# EVERY flag carries an owner, a reason, an expiry and a removal plan in
# docs/feature-flags.yaml. An expired flag FAILS THE BUILD, exactly as an
# expired security allowlist entry does, because both solve the same problem:
# a temporary decision quietly becoming permanent. See ADR-0017.
# ==========================================================================

# Expose the MCP server. Off until the tool schemas are generated from the API
# models. TASK-P0-030.
METER_FEATURE_MCP_SERVER=false

# Master switch for ingestion. Off stops every collector, which is the switch
# you want at three in the morning.
METER_FEATURE_INGESTION=true

# Individual collectors, so one misbehaving collector is disabled without
# stopping the rest.
METER_FEATURE_COLLECTOR_ORG_TREE=true
METER_FEATURE_COLLECTOR_ACCOUNT_HEALTH=true
METER_FEATURE_COLLECTOR_PLATFORM_COST=true

# Retention jobs. Off is a deliberate, temporary, auditable act. Leaving it off
# means holding data past policy.
METER_FEATURE_RETENTION_JOBS=true

# Write an audit_event on every scope evaluation. There is no legitimate reason
# to turn this off in a deployed environment. It exists so a load test does not
# generate ten million audit rows.
METER_FEATURE_SCOPE_AUDIT=true

# Allow the local identity provider. Ignored, and rejected at startup, when
# METER_ENV is prod.
METER_FEATURE_LOCAL_AUTH=true


# ==========================================================================
# 8. BUILD AND DEPLOY
#
# Read by the Makefile and the pipeline, not by the application.
# ==========================================================================

# WHAT     Target architecture for every image build.
# WHY      A build on Apple Silicon produces arm64 and a push does not convert
#          it, so an amd64 host fails with `exec format error`. See README 5.1.
# READ BY  Makefile, .gitlab-ci.yml
PLATFORM=linux/amd64

# WHAT     AWS account and region hosting the platform itself.
# WHY      Builds the ECR registry hostname. Not a member account.
# READ BY  Makefile, .gitlab-ci.yml
AWS_ACCOUNT_ID=
AWS_REGION=eu-west-1

# WHAT     Which Terraform environment `make tf-*` targets act on.
# READ BY  Makefile
TF_ENV=dev

# WHAT     Where pxpipe writes its token usage log.
# WHY      Machine global by default, so figures are not scoped to Meter.
#          Override for a per project log. See ISS-081.
# READ BY  Makefile targets `dev` and `stats`
# PXPIPE_LOG=./.pxpipe-events.jsonl

# ==========================================================================
# 9. QUERY COST GOVERNANCE, P2
# ==========================================================================
#
# Every value here was a literal in the prototype. Each one is a policy
# decision rather than a constant: a price, an assumption about how a dashboard
# is used, or a threshold that decides what gets flagged.

# WHAT     List prices for the two billed engines.
# WHY      Modelled, not measured. A Logs Insights query is billed per GB
#          scanned and a metric query per metric requested, and neither figure
#          is verifiable until TASK-P2-020 back tests it against a bill.
#          ISS-093 until then.
# READ BY  finops_query/cost_model.py
METER_QUERY_LOGS_SCAN_PRICE_PER_GB=0.005
METER_QUERY_METRICS_PRICE_PER_1000=0.01

# WHAT     How a dashboard with no auto refresh is assumed to be used.
# WHY      A panel nobody refreshes still costs money when somebody opens it.
#          Four loads a day is an assumption and it is stated rather than
#          buried, because it decides the figure for every manual dashboard.
# READ BY  finops_query/cost_model.py
METER_QUERY_MANUAL_LOADS_PER_DAY=4.0

# WHAT     How long a dashboard is assumed to be open and refreshing.
# WHY      The single biggest lever on a modelled cost. Two hours a day against
#          twenty four is a factor of twelve, so this number decides whether a
#          finding is a rounding error or a headline.
# READ BY  finops_query/cost_model.py
METER_QUERY_VIEWING_HOURS_PER_DAY=2.0

# WHAT     Metrics requested per GetMetricData call.
# WHY      Billing is per metric, not per call, so a panel charting twenty
#          series costs twenty times a panel charting one. One is the
#          conservative default and understates a busy panel.
# READ BY  finops_query/cost_model.py
METER_QUERY_METRICS_PER_CALL=1.0

# WHAT     Assumed log group ingestion when it cannot be measured.
# WHY      The whole Logs Insights estimate rests on this: scan per run is
#          ingestion multiplied by the window. Fifty GB a day is a guess, and a
#          figure derived from it says so.
# READ BY  finops_query/cost_model.py
METER_QUERY_DEFAULT_INGEST_GB_PER_DAY=50.0

# WHAT     Assumed duration of one Logs Insights query, in seconds.
# WHY      Used only for quota pressure, never for cost. It converts runs per
#          day into query seconds against the concurrency quota.
# READ BY  finops_query/cost_model.py
METER_QUERY_ASSUMED_QUERY_SECONDS=5.0

# WHAT     Refresh intervals at or below these are flagged, in seconds.
# WHY      A thirty second refresh runs a query 2,880 times a day. These two
#          numbers decide what counts as fast enough to mention.
# READ BY  finops_query/cost_model.py
METER_QUERY_REFRESH_WARN_SECONDS=60
METER_QUERY_REFRESH_CRIT_SECONDS=30

# WHAT     Dashboard time ranges at or above these are flagged, in hours.
# WHY      Window width multiplies scan volume directly on Logs Insights. A
#          week is the point where one panel can outspend a small service.
# READ BY  finops_query/cost_model.py
METER_QUERY_TIMERANGE_WARN_HOURS=24
METER_QUERY_TIMERANGE_CRIT_HOURS=168

# WHAT     How much Meter is allowed to change in a query surface.
# WHY      FEAT-014 and FEAT-017. `none` writes nothing. `workspace_floor`
#          permits one setting on a workspace, the smallest possible write
#          surface with no dashboard touched. `full` permits a panel rewrite,
#          which is the first time Meter changes somebody's dashboard. It
#          defaults to `none` everywhere, so enabling a write is a decision
#          somebody signs rather than one they inherit.
# READ BY  finops_ingest/remediation.py
# VALUES   none | workspace_floor | full
METER_QUERY_WRITE_LEVEL=none
# WHAT     The AWS service quotas the model measures pressure against.
# WHY      Measured against, never set by us. A dashboard can exhaust a
#          concurrency quota without costing much, which is a different failure
#          from an expensive one and is reported separately.
# READ BY  finops_query/cost_model.py
METER_QUERY_QUOTA_LOGS_CONCURRENT=30
METER_QUERY_QUOTA_GETMETRICDATA_TPS=50
