# Meter API. Multi stage so the runtime image carries no build toolchain.
#
# Build context is the repository root:
#   docker build -f docker/Dockerfile.api -t meter-api .

# ---------- builder ----------
FROM public.ecr.aws/docker/library/python:3.12-slim AS builder

ENV PIP_NO_CACHE_DIR=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1 \
    PYTHONDONTWRITEBYTECODE=1

WORKDIR /build

RUN apt-get update \
 && apt-get install -y --no-install-recommends build-essential \
 && apt-get clean

# Dependency layer first so a source change does not reinstall the world.
COPY pyproject.toml ./
RUN python -m venv /opt/venv \
 && /opt/venv/bin/pip install --upgrade pip setuptools wheel \
 && /opt/venv/bin/pip install .

COPY finops_core/      ./finops_core/
COPY finops_providers/ ./finops_providers/
COPY finops_ingest/    ./finops_ingest/
COPY finops_api/       ./finops_api/
COPY alembic.ini       ./
COPY migrations/       ./migrations/

RUN /opt/venv/bin/pip install --no-deps .

# ---------- runtime ----------
FROM public.ecr.aws/docker/library/python:3.12-slim AS runtime

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PATH="/opt/venv/bin:$PATH"

# Non root. The ECS task role supplies AWS credentials, so no secret is baked
# into the image at any layer.
RUN groupadd --gid 10001 meter \
 && useradd --uid 10001 --gid meter --no-create-home --shell /usr/sbin/nologin meter

WORKDIR /app

COPY --from=builder /opt/venv /opt/venv
COPY --from=builder /build/alembic.ini /build/migrations ./

USER meter

EXPOSE 8000

# The health route reports database reachability and ingestion freshness, so a
# container that cannot see its data is unhealthy rather than quietly serving
# stale numbers.
HEALTHCHECK --interval=30s --timeout=5s --start-period=20s --retries=3 \
    CMD python -c "import urllib.request,sys; sys.exit(0 if urllib.request.urlopen('http://127.0.0.1:8000/healthz', timeout=4).status==200 else 1)"

CMD ["uvicorn", "finops_api.main:app", "--host", "0.0.0.0", "--port", "8000", "--proxy-headers"]
