# Meter frontend on Minimus. See ADR-0010.
#
#   docker build -f docker/Dockerfile.web -t meter-web .
#
# No HEALTHCHECK, for the same reason as the API image: the runtime has no wget
# and no curl, and the ALB target group is the control that gates the rollout.

ARG NODE_VERSION=22
ARG NGINX_VERSION=1.27

FROM reg.mini.dev/node:${NODE_VERSION}-dev AS builder

WORKDIR /build

COPY finops-web/package.json finops-web/package-lock.json ./
RUN npm ci --no-audit --no-fund

COPY finops-web/ ./
RUN npm run build

FROM reg.mini.dev/nginx:${NGINX_VERSION}

COPY docker/nginx.conf /etc/nginx/conf.d/default.conf
COPY --from=builder /build/dist /usr/share/nginx/html

USER 65532:65532

EXPOSE 8080

ARG GIT_SHA=unknown
LABEL org.opencontainers.image.title="meter-web" \
      org.opencontainers.image.revision="${GIT_SHA}" \
      io.meter.module="web"
